# Reference only. After a fresh isolated `up`, load that run's mode-0600
# <runtimeDir>/app.env into the Next process environment as described in
# README.md. Keep .env.local absent and never share the service-role key.
CLOSR_SUPABASE_URL=http://127.0.0.1:54321
CLOSR_SUPABASE_ANON_KEY=generated-by-installer
SUPABASE_SERVICE_ROLE_KEY=generated-by-installer

# The open-source preview works with these values unset/false.
CLOSR_ENABLE_ENGINE_PREVIEW=false
CLOSR_ENGINE_URL=
CLOSR_ENABLE_FULL_ENGINE=false
CLOSR_FULL_ENGINE_URL=
