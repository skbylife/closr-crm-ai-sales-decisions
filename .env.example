# Names and descriptions only. Supply your own values locally; never commit credentials.
# For Docker, scripts/native-init.mjs generates private .env.self-hosted automatically.

# Native backend: set both to postgres.
CLOSR_DATABASE_BACKEND=
NEXT_PUBLIC_CLOSR_DATABASE_BACKEND=
# Application HTTP(S) origin, including port when not the default.
NEXT_PUBLIC_APP_URL=
# Direct PostgreSQL URI, server only; local non-TLS instances use PG_SSL=false.
DATABASE_URL=
PG_SSL=
# Docker-only database password (generated by native-init), bind address and port.
POSTGRES_PASSWORD=
CLOSR_BIND_ADDRESS=
CLOSR_PORT=
# Persistent directories for the native MFA encryption key and private attachments.
CLOSR_DATA_DIR=
CLOSR_STORAGE_DIR=

# Optional AI: leave unconfigured until you approve a provider and data processing.
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_PRO_MODEL=
AI_PRO_BASE_URL=
AI_PRO_API_KEY=
# Embeddings must match the database's 1536 dimensions and model identifier.
AI_EMBEDDING_MODEL=
AI_CAPABILITIES=
AI_CUSTOMER_OWNED=
AI_ALLOW_EXTERNAL_PROVIDER=
# Optional integrations; none are needed to create a workspace and use the CRM.
RESEND_API_KEY=
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=
WEBHOOK_SECRET=
TAVILY_API_KEY=
PUBLIC_WEB_EVIDENCE_ENABLED=
SCRAPLING_ENABLED=

# Optional operator-owned mail forwarding domain; default is a reserved example domain.
NEXT_PUBLIC_FORWARD_DOMAIN=

# Optional analytics; leave empty for no third-party analytics requests.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
